{
  "expo": {
    "name": "ResourceFlow",
    "slug": "resourceflow-frontend",
    "orientation": "default",
    "icon": "./assets/images/resourceflow.png",
    "scheme": "resourceflowfrontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a7ea4",
        "foregroundImage": "./assets/images/resourceflow-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/resourceflow-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/resourceflow-favicon.png",
      "name": "ResourceFlow",
      "shortName": "ResourceFlow",
      "description": "Multi-location resource booking platform",
      "themeColor": "#0a7ea4",
      "backgroundColor": "#111214"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/resourceflow-foreground.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a7ea4",
          "dark": {
            "backgroundColor": "#111214"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
