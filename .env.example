# ResourceFlow Configuration

# --- BACKEND ---
# JWT signing key — REQUIRED, min 32 chars, must be unique per deployment.
# Generate one with: openssl rand -base64 48
JWT_KEY=your_secure_random_key_here_min_32_chars

# SQLite connection string
CONNECTION_STRING=Data Source=./resourceflow.db

# Comma-separated allowed CORS origins — REQUIRED, wildcards are not permitted.
CORS_ORIGINS=https://your-frontend-domain.com

# Default UI locale served on GET /api/brand. Valid values: en, fr, es, de.
# Unset or unsupported falls back to en.
RESOURCEFLOW_DEFAULT_LOCALE=en

# Where the admin's API Keys screen links out to, served on GET /api/brand. Leave these unset
# to hide links with no configured destination. Set them to this deployment's client, guide
# and repository. Values that aren't http(s) URLs are ignored.
# RESOURCEFLOW_CLI_PACKAGE_URL=
# RESOURCEFLOW_API_DOCS_URL=
# RESOURCEFLOW_REPOSITORY_URL=

# Initial Admin Credentials — REQUIRED on first boot (only used to seed the DB if empty).
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# VAPID Push Notifications (leave empty to disable — app degrades gracefully)
# Generate keys with: npx web-push generate-vapid-keys
Vapid__PublicKey=
Vapid__PrivateKey=
Vapid__Subject=mailto:you@your-domain.com

# Guest booking reminders (native app + PWA). Hours before the slot at which a reminder
# goes out; the Expo access token is only needed if your EAS project enabled enhanced push
# security. Browser reminders reuse the VAPID keys above.
GuestPush__ReminderLeadHours=24,2
GuestPush__ExpoAccessToken=

# Wallet passes (leave empty to disable — the booking screens offer only what is configured).
# Apple: a Pass Type ID certificate exported as .p12 plus Apple's WWDR intermediate certificate.
# Google: a Wallet issuer ID and a service-account JSON key with Wallet Object Issuer access.
Wallet__Apple__PassTypeIdentifier=
Wallet__Apple__TeamIdentifier=
Wallet__Apple__CertificatePath=
Wallet__Apple__CertificatePassword=
Wallet__Apple__WwdrCertificatePath=
Wallet__Google__IssuerId=
Wallet__Google__ServiceAccountKeyPath=

# SMTP Settings for Email Notifications
EmailSettings__Host=smtp.example.com
EmailSettings__Port=587
EmailSettings__Username=user@example.com
EmailSettings__Password=your_smtp_password
EmailSettings__FromEmail=noreply@example.com
EmailSettings__FromName=ResourceFlow
EmailSettings__EnableSsl=true

# --- REVERSE PROXY ---
# Comma-separated addresses or CIDR ranges of a proxy in front of the bundled nginx
# (Caddy, Traefik, Cloudflare Tunnel). Leave empty when nginx faces the internet directly.
TRUSTED_PROXIES=

# --- FRONTEND ---
# Backend API base URL for the frontend
EXPO_PUBLIC_API_URL=http://localhost:5062
